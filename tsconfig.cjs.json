{
  "extends": "./tsconfig.esm.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "skipLibCheck": true,
    "outDir": "./dist/cjs",
    "rootDir": "./src",
    "baseUrl": "./"
  },
  "include": ["src/**/*"],
  "exclude": ["src/__tests__"]
}
