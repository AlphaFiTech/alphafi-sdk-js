{
  "name": "@alphafi/alphafi-sdk",
  "version": "2.1.0",
  "description": "AlphaFi SDK for JavaScript",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run build:esm",
    "build:esm": "tsc --project tsconfig.esm.json && echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "lint": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "test": "npm run test:esm",
    "test:esm": "NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" jest --config jest.config.esm.js --silent --verbose=false",
    "docs": "typedoc"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "sui",
    "defi",
    "alphafi",
    "sdk",
    "blockchain",
    "yield",
    "lending",
    "liquidity"
  ],
  "author": "AlphaFi",
  "license": "ISC",
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@alphafi/alphalend-sdk": "^3.0.2",
    "@alphafi/stsui-sdk": "^2.0.2",
    "@cetusprotocol/aggregator-sdk": "^1.5.5",
    "@cetusprotocol/common-sdk": "^1.3.7",
    "@naviprotocol/lending": "^2.0.3",
    "@pythnetwork/pyth-sui-js": "^2.2.0",
    "bn.js": "^5.2.2",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@mysten/sui": "2.22.0",
    "@types/bn.js": "^5.1.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.3.4",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typedoc": "^0.28.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.14.0"
  },
  "peerDependencies": {
    "@mysten/sui": "^2.22.0"
  },
  "overrides": {
    "@mysten/sui": "2.22.0"
  }
}
